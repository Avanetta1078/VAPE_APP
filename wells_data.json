      'dd-sv': w.sv !== null && w.sv !== undefined ? `${fmt(w.sv,1)} lb` : '—',
      'dd-mpt': w.mpt !== null && w.mpt !== undefined ? `${fmt(w.mpt,2)} in` : '—',
      'dd-ept': w.ept !== null && w.ept !== undefined ? `${fmt(w.ept,2)} in` : '—',
      'dd-pipdyn': w.pipdyn !== null && w.pipdyn !== undefined ? `${fmt(w.pipdyn,1)} kg` : '—',
      'dd-rodpower': w.rodpower !== null && w.rodpower !== undefined ? `${fmt(w.rodpower,1)} HP` : '—',
    };
    Object.keys(ddMap).forEach(id => {
      const el = document.getElementById(id);
      if(el) el.textContent = ddMap[id];
    });
  }

  function goToWell(name){
    if(WELLS_DB[name] && wellNames.includes(name)){ currentWell = name; renderWell(); return true; }
    return false;
  }

  function findWellByQuery(raw){
    const q = raw.trim().toUpperCase();
    if(!q) return null;
    // exact match first
    let found = wellNames.find(n => n.toUpperCase() === q);
    if(found) return found;
    // numeric-only query: match the number portion of the well name (e.g. "966" -> "E-966(d)")
    if(/^\d+$/.test(q)){
      const matches = wellNames.filter(n => {
        const m = n.match(/(\d+)/);
        return m && m[1] === q;
      });
      if(matches.length === 1) return matches[0];
      if(matches.length > 1) return matches[0]; // ambiguous: take first (e.g. plain vs "(d)")
    }
    // partial match fallback (e.g. "ED-3" or "83")
    found = wellNames.find(n => n.toUpperCase().includes(q));
    return found || null;
  }

  function initWellSearch(){
    const input = document.getElementById('wellSearch');
    if(!input) return;
    input.addEventListener('keydown', (e)=>{
      if(e.key === 'Enter'){
        const found = findWellByQuery(input.value);
        if(found){
          goToWell(found);
          input.style.borderColor = '';
          input.placeholder = 'Buscar… (ej. 966)';
        } else {
          input.value = '';
          input.placeholder = 'No encontrado — probá "966"';
        }
      }
    });
    // Sincroniza con el buscador de la grilla de Inicio: son un solo buscador
    // en la practica, no dos independientes.
    input.addEventListener('input', ()=>{
      const ifSearch = document.getElementById('ifSearch');
      if(ifSearch && ifSearch.value !== input.value){
        ifSearch.value = input.value;
        if(typeof renderInicioGrid === 'function') renderInicioGrid();
      }
    });
  }

  // ---- Tarea 3: grilla general Inicio ----
  const fmtN = (v, d=1) => (v === null || v === undefined) ? '—' : fmt(v, d);
  let inicioPage = 0;

  function renderInicioPager(page, totalPages){
    const el = document.getElementById('inicioPager');
    if(!el) return;
    if(totalPages <= 1){ el.innerHTML = ''; return; }
    el.innerHTML = `
      <button id="inicioPagerPrev" ${page<=0?'disabled':''}>‹ Anterior</button>
      <span>Página ${page+1} de ${totalPages}</span>
      <button id="inicioPagerNext" ${page>=totalPages-1?'disabled':''}>Siguiente ›</button>
    `;
    const prevBtn = document.getElementById('inicioPagerPrev');
    const nextBtn = document.getElementById('inicioPagerNext');
    if(prevBtn) prevBtn.addEventListener('click', ()=>{ inicioPage--; renderInicioGrid(); });
    if(nextBtn) nextBtn.addEventListener('click', ()=>{ inicioPage++; renderInicioGrid(); });
  }

  function getScopedWellEntries(){
    return wellNames.map(n => Object.assign({ name: n }, WELLS_DB[n]));
  }

  function populateInicioFilterOptions(){
    const entries = getScopedWellEntries();
    const ops = [...new Set(entries.map(e => e.operadora).filter(Boolean))].sort();
    const bats = [...new Set(entries.map(e => e.bateria).filter(Boolean))].sort();
    const opSel = document.getElementById('ifOperadora');
    const batSel = document.getElementById('ifBateria');
    if(opSel){
      const cur = opSel.value;
      opSel.innerHTML = '<option value="">Todas</option>' + ops.map(o=>`<option value="${o}">${o}</option>`).join('');
      opSel.value = ops.includes(cur) ? cur : '';
      // Si el usuario cliente solo tiene 1 operadora, no tiene sentido el filtro
      opSel.closest('.ifilter').style.display = ops.length > 1 ? 'flex' : 'none';
    }
    if(batSel){
      const cur = batSel.value;
      batSel.innerHTML = '<option value="">Todas</option>' + bats.map(b=>`<option value="${b}">${b}</option>`).join('');
      batSel.value = bats.includes(cur) ? cur : '';
    }
    const fechaSel = document.getElementById('ifFecha');
    if(fechaSel){
      const porFecha = {};
      entries.forEach(e => { if(e.dt){ porFecha[e.dt] = (porFecha[e.dt]||0) + 1; } });
      const fechas = Object.keys(porFecha).sort().reverse();
      fechaSel.innerHTML = '<option value="">Todas</option>' +
        fechas.map(f => `<option value="${f}">${fmtDate(f)} (${porFecha[f]} pozo${porFecha[f]===1?'':'s'})</option>`).join('');
      fechaSel.value = '';
    }
  }

  function renderInicioGrid(){
    const body = document.getElementById('inicioTableBody');
    if(!body) return;
    const q = (document.getElementById('ifSearch').value || '').trim().toLowerCase();
    const opF = document.getElementById('ifOperadora').value;
    const batF = document.getElementById('ifBateria').value;
    const fechaF = document.getElementById('ifFecha').value;
    const ensF = document.getElementById('ifEnsayo').value;

    let entries = getScopedWellEntries();
    if(opF) entries = entries.filter(e => e.operadora === opF);
    if(batF) entries = entries.filter(e => e.bateria === batF);
    if(fechaF) entries = entries.filter(e => e.dt === fechaF);
    if(ensF === 'dyn') entries = entries.filter(e => e.hasDyn);
    if(ensF === 'acu') entries = entries.filter(e => e.hasAcu && !e.hasDyn);
    if(q){
      entries = entries.filter(e =>
        e.name.toLowerCase().includes(q) || e.name.replace(/\D/g,'').includes(q)
      );
    }
    entries.sort((a,b)=> {
      if(a.dt && b.dt && a.dt !== b.dt) return a.dt < b.dt ? 1 : -1; // fecha mas reciente primero
      if(a.dt && !b.dt) return -1;
      if(!a.dt && b.dt) return 1;
      return naturalCompare(a.name, b.name);
    });

    const stamp = document.getElementById('inicioCountStamp');
    if(stamp) stamp.textContent = `${entries.length} pozo${entries.length===1?'':'s'}`;

    if(!entries.length){
      body.innerHTML = `<tr><td colspan="12" style="text-align:center; color:var(--ink-faint); padding:22px;">Sin pozos que coincidan con los filtros.</td></tr>`;
      renderInicioPager(0, 0);
      return;
    }

    const PAGE_SIZE = 100;
    const totalPages = Math.max(1, Math.ceil(entries.length / PAGE_SIZE));
    if(inicioPage >= totalPages) inicioPage = totalPages - 1;
    if(inicioPage < 0) inicioPage = 0;
    const pageEntries = entries.slice(inicioPage * PAGE_SIZE, (inicioPage + 1) * PAGE_SIZE);
    renderInicioPager(inicioPage, totalPages);

    body.innerHTML = pageEntries.map(e => {
      const pendiente = !e.hasDyn && !e.hasAcu;
      return `
      <tr class="${pendiente ? 'row-pendiente' : ''}">
        <td style="white-space:nowrap;">
          <button class="row-preview-btn" data-preview="${e.name}" title="Vista rápida de la carta">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.7"/></svg>
          </button>
          <button class="row-preview-btn" data-quickload="${e.name}" data-operadora="${e.operadora||''}" title="Carga rápida de CSV/TXT para este pozo" style="margin-left:4px;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M5 4h11l3 3v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 4v5h7V4M8 14h8v6H8v-6Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
          </button>
          <button class="row-preview-btn" data-delete="${e.name}" title="Eliminar pozo de la base de datos" style="margin-left:4px; color:var(--rust,#c0603a); border-color:rgba(192,96,58,.4);">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </td>
        <td class="well-name" data-goto="${e.name}">${e.name}${pendiente ? ' <span class="pending-badge" title="Dado de alta pero todavía sin CSV/TXT de ensayo cargado">⚠ pendiente</span>' : ''}</td>
        <td>${fmtDate(e.dt)}</td>
        <td>${e.bateria || '—'}</td>
        <td class="dim">${e.operadora || '—'}</td>
        <td>${fmtN(e.nivel,0)}</td>
        <td>${fmtN(e.sumerg,0)}</td>
        <td>${fmtN(e.fillage,1)}</td>
        <td>${fmtN(e.fomax,0)}</td>
        <td>${fmtN(e.tv,0)}</td>
        <td>${fmtN(e.spm,2)}</td>
        <td title="${(e.commentDyn||'').replace(/"/g,'&quot;')}">${e.commentDyn || '—'}</td>
      </tr>
    `;}).join('');

    body.querySelectorAll('[data-goto]').forEach(el=>{
      el.addEventListener('click', ()=>{
        goToWell(el.dataset.goto);
        document.querySelectorAll('#menu button').forEach(b=>b.classList.remove('active'));
        document.querySelector('#menu button[data-view="dina"]').classList.add('active');
        document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
        document.getElementById('view-dina').classList.add('active');
      });
    });
    body.querySelectorAll('[data-preview]').forEach(el=>{
      el.addEventListener('click', ()=> openQuickPreview(el.dataset.preview));
    });
    body.querySelectorAll('[data-quickload]').forEach(el=>{
      el.addEventListener('click', ()=> goToQuickLoad(el.dataset.quickload, el.dataset.operadora));
    });
    body.querySelectorAll('[data-delete]').forEach(el=>{
      el.addEventListener('click', ()=> deleteWellFromGrid(el.dataset.delete));
    });
  }

  async function deleteWellFromGrid(wellName){
    if(!supabaseClient){ alert('Sin conexión a la base de datos.'); return; }
    const ok1 = confirm(`¿Eliminar el pozo "${wellName}" de la base de datos?\n\nEsto borra también todos sus ensayos, resultados y curvas guardadas. No se puede deshacer.`);
    if(!ok1) return;
    const typed = prompt(`Para confirmar, escribí el nombre exacto del pozo: ${wellName}`);
    if(typed !== wellName){ alert('No coincide el nombre — no se borró nada.'); return; }
    try{
      const { data: wellRow, error: findErr } = await supabaseClient
        .from('wells').select('well_id').eq('well_name', wellName).maybeSingle();
      if(findErr) throw findErr;
      if(!wellRow){ alert('No se encontró ese pozo en la base (puede que ya haya sido borrado).'); return; }
      const { error: delErr } = await supabaseClient.from('wells').delete().eq('well_id', wellRow.well_id);
      if(delErr) throw delErr;
      delete WELLS_DB[wellName];
      delete ACU_CURVE_CACHE[wellName];
      delete CHART_MAP[wellName];
      wellNames = Object.keys(WELLS_DB).sort(naturalCompare);
      if(currentWell === wellName){ currentWell = wellNames[0]; }
      populateInicioFilterOptions();
      renderInicioGrid();
      renderWell();
      alert(`Pozo "${wellName}" eliminado.`);
    } catch(e){
      console.error('Error eliminando pozo:', e);
      alert('Error al eliminar: ' + (e.message || JSON.stringify(e)));
    }
  }

  function goToQuickLoad(wellName, operadora){
    document.querySelectorAll('#menu button').forEach(b=>b.classList.remove('active'));
    document.querySelector('#menu button[data-view="herramientas"]').classList.add('active');
    document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
    document.getElementById('view-herramientas').classList.add('active');

    const opSel = document.getElementById('uploadOperadora');
    if(opSel && operadora) opSel.value = operadora;

    // Limpia el CSV y el TXT seleccionados antes (si venian de una carga anterior),
    // para que la carga rapida por disquete solo suba lo que efectivamente elijas ahora.
    const csvInput = document.getElementById('uploadCsv');
    const txtInput = document.getElementById('uploadTxt');
    const csvName = document.getElementById('uploadCsvName');
    const txtName = document.getElementById('uploadTxtName');
    if(csvInput) csvInput.value = '';
    if(txtInput) txtInput.value = '';
    if(csvName) csvName.textContent = 'Ningún archivo';
    if(txtName) txtName.textContent = 'Ningún archivo';
    const previewArea = document.getElementById('uploadPreviewArea');
    if(previewArea) previewArea.innerHTML = '';

    let hint = document.getElementById('quickLoadHint');
    if(!hint){
      hint = document.createElement('p');
      hint.id = 'quickLoadHint';
      hint.className = 'up-note';
      hint.style.marginBottom = '10px';
      const desc = document.querySelector('.tool-desc');
      if(desc) desc.insertAdjacentElement('afterend', hint);
    }
    hint.innerHTML = `Cargando para <strong>${wellName}</strong> — subí solo lo que le falte (CSV y/o TXT). El campo CSV quedó vacío a propósito para no volver a procesar uno viejo.`;
  }